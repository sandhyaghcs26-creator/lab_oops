class Student{
int usn;
String name;

void accept()
{
 Scanner sc =new Scanner(Systemi.in);
 System.out.println("Enter the USN and NAME:");
 usn=sc.nextInt();
 name=sc.nextLine();
}
void display()
{
 System.out.println("USN" +usn);
 System.out.println("NAME" +name);
